<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 24-30 (API 31+ uses data_extraction_rules.xml).

   Same reasoning as there: music_prefs.xml holds SAF `content://` grants and
   MediaStore ids that are meaningless after a restore onto another device, so
   restoring it would produce a silently broken library instead of a clean
   first run.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="music_prefs.xml" />
</full-backup-content>
