<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules (API 31+).

   music_prefs.xml is excluded on purpose. It stores SAF `content://` grants
   (library_tree_uri, custom_bg_uri) and song ids that are either SAF URIs or
   MediaStore row ids. None of those survive a restore onto a different device
   or a reinstall: the URI permission is gone and MediaStore ids are re-issued.
   Restoring them would leave the app pointing at unreadable URIs — an empty
   library and a missing background with no way for the user to tell why.
   A clean first-run state is the recoverable outcome.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="music_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="music_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
